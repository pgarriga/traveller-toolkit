# Line endings
#
# The repo grew with mixed CRLF/LF files, which made a one-line edit show up as
# a whole-file diff depending on which tool touched it. Everything text is now
# stored as LF in the repository and checked out as LF in every working tree,
# on Windows too — Vite, Node and the TypeScript toolchain are all fine with LF.
* text=auto eol=lf

# Binary assets: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Generated: collapsed by default in GitHub diffs (still readable locally).
package-lock.json linguist-generated=true
